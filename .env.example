# AIRI environment configuration.
# Copy to .env and adjust. The local demo works with the defaults below:
# SQLite + demo_mock LLM substitute + synthetic fixtures, fully offline.

AIRI_APP_NAME=AIRI
AIRI_ENVIRONMENT=local
AIRI_LOG_LEVEL=INFO

# Local demo database (SQLite file, auto-created by migrations).
AIRI_DATABASE_URL=sqlite+pysqlite:///.demo/airi_web_demo.db

# Deterministic demo LLM substitute - no API key, no network calls.
AIRI_LLM_MODE=demo_mock

# Mock execution over bundled synthetic fixtures.
AIRI_EXECUTION_MODE=mock
AIRI_DEMO_FIXTURES=true

# Allow the Vite dev server origin.
AIRI_CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------------------
# Real LLM (optional - never required for the demo).
# The endpoint must support Chat Completions response_format=json_schema
# with strict=true. Invalid/unsupported responses raise errors; AIRI never
# silently falls back to the demo mock.
# ---------------------------------------------------------------------------
# AIRI_LLM_BASE_URL=https://api.openai.com/v1
# AIRI_LLM_MODEL=configure-your-model
# AIRI_LLM_API_KEY=change-me
# AIRI_LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Real Spark Thrift test endpoint (optional - operator-verified test cluster
# only, NOSASL, read-only; production use is NOT supported).
# Left commented, the execution mode stays `mock` and integration tests skip.
# ---------------------------------------------------------------------------
# AIRI_EXECUTION_MODE=spark_test
# AIRI_SPARK_HOST=your-test-host.example.com
# AIRI_SPARK_PORT=10000
# AIRI_SPARK_USERNAME=your-test-reader
# AIRI_SPARK_PASSWORD=
# NOSASL only; LDAP/KERBEROS are explicitly unsupported extension points.
# AIRI_SPARK_AUTH_MODE=NOSASL
# AIRI_SPARK_DATABASE=c_db
# AIRI_SPARK_CONNECT_TIMEOUT_SECONDS=10
# AIRI_SPARK_QUERY_TIMEOUT_SECONDS=60
# AIRI_SPARK_SESSION_TIMEZONE=Asia/Shanghai
# AIRI_SPARK_MAX_ROWS=1000
# AIRI_SPARK_FIXTURE_MAPPING=false
# AIRI_SPARK_READ_ONLY_ATTESTED=false
